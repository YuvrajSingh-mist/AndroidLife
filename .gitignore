# --- generated / regenerable artifacts (do not commit; rebuild via scripts) ---
# Entire assets/ tree is local/HF (runs, seeds, Phoenix DBs, etc.) — never git.
# datasets/ stays at the repo root.
assets/
datasets/

# --- personal / device-specific data (never commit) ---
.env
config/user.yaml
backups/
.fabricated_test_data.json
benchmarks/androidlife-530/tasks_vars.local.env
benchmarks/androidlife-530/tasks_vars.local.json
benchmarks/androidlife-530/tasks_vars/
benchmarks/androidlife-530/public_vars.local.env
benchmarks/androidlife-530/tasks-private/
report_wireless.json
report_wireless.md

# --- tooling noise ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv
.venv.nosync/
.DS_Store
src/*.egg-info/
.deepeval/
.mobilerun/

# generated report artifacts (androidlife_report.py writes into CWD)
report.json
report.md
metrics/
coverage.xml
htmlcov/

# website build output
website/node_modules/

# dev scratch scripts (underscore-prefixed)
scripts/_*.py

# public-sample benchmark run artifacts (generated; not committed) — now live
# under assets/runs/public/ (covered by the assets/runs/ rule above)

# Hugging Face release staging (generated by scripts/data/export_hf_release.py)
hf_release/

# trajectory media + per-task data — published to HuggingFace (see
# scripts/tools/publish_trajectories.py), not committed to git. The small
# index.json manifest IS committed (it points at the HF resolve URLs).
website/assets/trajectories/
website/assets/data/trajectories/day*/
website/assets/data/trajectories/public/

# Private website checkout (own git remote → Vercel). Do not commit into AndroidLife.
androidlife-website/
website-src/

# Manual per-run audit working notes (keep local; not for GitHub)
reports/public/audit-*/

# benchmark runner scratch state (local only)
.drain_*
benchmarks/androidlife-600

# Redo queue: tasks whose recorded results aren't trustworthy (local only)
redo.md

# Reset/seed operator runbook — holds real serials + account emails + failure log.
# The sanitized, tracked copy is .agents/skills/reset-phone/SKILL.md
scripts/seeding/SKILL.md

# X / tweet series drafts for AndroidLife (local only, not for GitHub)
androidlife-tweets/

# Logo concept explorations for AndroidLife (local only; see promo/logo-concepts/)
promo/

# Long-form blog drafts for AndroidLife (local only; published into the SmolHub site repo)
blogs/

# Local run/plan caches (e.g. scripts/hf/upload_530_ui_states.py)
.cache/
.seed_state.json
