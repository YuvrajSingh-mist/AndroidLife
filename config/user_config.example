# DrainBench user config — EXAMPLE / defaults.
#
# Copy this to `config/user.yaml` and edit the values to YOUR persona, OR just
# run as-is: the shipped defaults below are a complete, working persona so the
# benchmark runs out of the box.
#
# This is a FLAT key -> value file. Both `key: value` and `key=value` forms are
# accepted; `#` starts a comment. Keys that match a prompt placeholder (e.g.
# `contact`, `food_category`, `stock name`) fill that placeholder directly.
# Keys like `contact_b`, `destination`, `item`, `stock note title` are used by
# ASK USER fact templates ({...}) and by the seed scripts.
#
# Run `uv run python scripts/verify_config.py` after editing to confirm every
# placeholder, fact, and seed across all 730 tasks resolves.

# ---- people -------------------------------------------------------------
# The person the agent messages / forwards to for any `[contact]` task.
# Pick a safe self-target on the test device (e.g. the device's own number).
contact: Yuvraj Airtel

# The person ASK USER facts mean by "the person I usually message" ({contact_b}).
contact_b: Yuvraj Singh Jio

# Contact to look up in the Contacts search task (`[contact name]`).
contact name: Maa

# Gmail sender for the "unread emails from [sender]" tasks (`[sender]`).
sender: Myntra

# Letter used by the "contacts starting with [letter]" task.
letter: Y

# ---- location ------------------------------------------------------------
# Train-departure ASK USER fact destination ({destination}).
destination: Cuttack

# Maps / weather target place near the device (`[place]`).
place: Bhubaneswar Airport

# Traffic check on the user's usual commute route (`[usual route]`).
usual route: 42 MG Road, Bhubaneswar

# Google workspace task sets (day 4+): Sheets workbook, column, Slides deck, Meet link.
spreadsheet name: SPORTS_VIDEO_DATA
sheet column: Views
presentation name: Q3 Review
meeting link: https://meet.google.com/abc-defg-hij

# ---- stock tracker (hard task #57) --------------------------------------
# Stock the agent tracks (`[stock name]`).
stock name: Reliance Industries

# Title of the Obsidian note holding the threshold + last recorded value
# (`[stock note title]`). The seed script creates this note on-device.
stock note title: Stock Watch

# Value the stock must cross to trigger a message (written into the seed note).
stock threshold: 1,400 INR

# Last recorded value in the stock note (written into the seed note).
stock last value: 1,385 INR
# ---- exam scores (day-4 medium__calculator__001) -------------------------
# Title of the Obsidian note holding the exam scores + weights the agent must
# read before computing the weighted average (`[exam scores note title]`). The
# seed script creates this note on-device (exam_scores.md).
exam scores note title: Exam Scores

# Minimum weighted average to pass (`[passing threshold]`). Written into the
# seeded Exam Scores note too, so the agent reads it from the same doc.
passing threshold: 60

# ---- calculator task data (day 4+) --------------------------------------
# Each of these names an Obsidian note the seed script materialises so the
# agent has a concrete doc to open and read the numbers from (never fabricate).
# Day-9 expense budget (medium__calculator__002): 5 categories + income.
budget note title: Monthly Budget

# Day-13 financing plans (medium__calculator__003): two plans for one purchase.
financing note title: Financing Plans

# Day-13 group bill split (hard__calculator-telegram-notes__020).
group bill note title: Group Bill

# Day-13 loan-vs-budget check (hard__calculator-obsidian-telegram__060, ASK USER).
# The Obsidian note holds the monthly budget the loan payment is compared against.
loan budget note title: Budget

# Day-15 shared bill (medium__calculator__005): bill + per-roommate usage levels.
shared bill note title: Shared Bill

# Day-18 trip fuel (medium__calculator__006): distance / mileage / gas / budget.
trip fuel note title: Trip Fuel

# Day-18 recipe cups->grams (medium__calculator-notes__001): 6 ingredients.
recipe note title: Recipe

# Day-19 debt payoff (medium__calculator__007): debt / payment / target date.
debt note title: Debt

# Day-21 compound interest (medium__calculator__008): principal + rate.
savings note title: Savings

# Day-21 recipe scale + pantry (hard__calculator-obsidian__058).
pasta recipe note title: Pasta Recipe
pantry list title: Pantry List

# Day-22 currency-adjusted price (medium__calculator__009): two country prices.
product prices note title: Product Prices

# Day-23 running total (easy__calculator__011): a list of numbers.
numbers list title: Numbers List

# Day-24 side-project break-even (medium__calculator__011): costs / earnings.
side project note title: Side Project

# Day-26 overtime pay (medium__calculator__012): rate / hours.
overtime note title: Overtime

# Day-26 savings goal (medium__calculator-calendar__001): goal + months.
savings goal note title: Savings Goal

# Day-18 temperature conversion value (`[temperature]`).
temperature: 25

# Day-19 bill split amount (`[bill amount]`).
bill amount: 120

# Day-24 square-root value (`[number]`).
number: 144

# Day-9 currency pair (`[currency pair]`, easy__calculator__002).
currency pair: USD to INR
# ---- notes ---------------------------------------------------------------
# Obsidian folder where the reschedule/confirm log is saved (`[meeting folder]`).
meeting folder: Meeting Notes

# Title of the Day-1 calendar meeting the agent must reschedule/confirm
# (`[meeting title]`); the seed script creates this event. Derived from an
# existing contact for realism. NOTE: avoid ':' in the value (content-provider
# bind values split on ':').
meeting title: 1 on 1 with Yuvraj Airtel

# Base title for the "Open Source Model News" note (`[news note title]`; the
# runner appends today's date at run time).
news note title: Open Source Model News

# Title for the Notes / Obsidian create-note tasks (`[note title]`).
note title: Daily Reflection

# ---- shopping ------------------------------------------------------------
# Two sites for the price-comparison task (`[shopping_website_1/_2]`).
shopping_website_1: amazon.in
shopping_website_2: flipkart.com

# Delivery site opened in Chrome to check for surcharges (`[food delivery site]`).
food delivery site: Swiggy

# The item being shopped for, revealed by the ASK USER fact ({item}).
item: wireless earbuds

# ---- media ---------------------------------------------------------------
# Photo category for the Gallery "best 3 by resolution" task (`[food_category]`).
food_category: pizza

# Word to search Messages for (`[search word]`).
search word: ticket

# ---- music / clock / sleep ------------------------------------------------
# Bedtime noted in the Obsidian 'Bedtime' note the sleep timer must not run past.
bedtime: 10:30 PM

# Recipe (name + URL) for the Clock multi-timer task; must have explicit
# multi-step timers (`[recipe]`).
recipe: World's Best Lasagna https://www.allrecipes.com/recipe/23600/worlds-best-lasagna/

# ---- misc ----------------------------------------------------------------
# Generic research topic used by several search tasks (`[topic]`).
topic: best budget smartphones 2026

# URL for the Chrome summarize-article task (`[article url]`).
article url: https://en.wikipedia.org/wiki/Open-source_software

# Exchange-rate pair for the Google Search task (`[currency pair]`).
currency pair: USD to INR

# Digit prefix for the Phone call-history filter task (`[digits]`).
digits: 98765

# ---- public-sample unambiguity (2026-08-18) ------------------------------
# Resolve the placeholders that make every non-ASK public task unambiguous:
# `[store]` — a real retailer with a physical-store locator on its website.
store: Decathlon
# `[restaurant]` — a real restaurant on the food-delivery site (see below).
restaurant: Downtown Delight
# `[product 1]` / `[product 2]` — two real, reviewable products.
product 1: Sony WH-1000XM5
product 2: Bose QuietComfort Ultra
# `[transit line]` — a real bus route for the "next departure" alarm task.
transit line: Route 205
# `[email-id]` — real recipient email for the professional email tasks (email is
# only used in professional settings; casual sharing uses `message [contact]`).
email-id: hafari4025@aghism.com
# `[size threshold]` — device-dependent file-size cutoff for the Files size task.
size threshold: 100MB

# `[notifying channel]` / `[related product]` / `[cinema]` / `[ticket price]` /
# `[weekly meeting]` / `[gym event]` / `[agenda file]` — device/persona named targets
# used by the hard DETERMINISTIC tasks in the public sample (match on-device/seeded state).
notifying channel: Tech Burner
related product: smartphone gimbal
cinema: INOX Bhubaneswar
ticket price: ₹240
weekly meeting: Weekly Sync
gym event: Gym
agenda file: Weekly Agenda

# ---- device layout (OPTIONAL overrides) ----------------------------------
# The seed scripts auto-detect these from the connected phone, so you normally
# DON'T need them. Set them only to force a value for a non-standard device:
#   vault path    - Obsidian vault dir on the device (auto-detected via find)
#   calendar id   - the Google-synced calendar id used for seeded events
#   contact email - fabricated email for the persona {contact} (seed scripts)
vault path: /sdcard/Obsidian/Papers vault oneplus 
calendar id: 16
contact email: yuvraj.airtel@example.com
