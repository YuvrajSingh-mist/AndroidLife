# Real/working values for the [placeholders] used in tasks_530.md (28-day schedule).
# Mirrors public_vars.local.env: the run pipeline merges config/user.yaml + this file
# (this file wins) into per-day vars via scripts/generate_day_vars.py, e.g.:
#   uv run python scripts/seeding/generate_day_vars.py --day 1
#   uv run python scripts/run/run_day.py --day 1
# Gitignored (personal/device-specific data): edit values freely - each task reads
# its placeholders at run time, so you control the concrete data inserted.
#
# Keys that only name a specific, otherwise-vague target carry a var (e.g. "an
# article" -> [article url]); tasks that say "the page I'm on", "any object", etc.
# stay natural and need no var.

# ---- people -------------------------------------------------------------
contact=Yuvraj Airtel
email-id=rajceo2031@gmail.com  # self-referencing: device owner's own primary Gmail (safe self-target)
gmeet title=Product Demo                 # easy__google-meet__004 (scheduled GMeet title)
gmeet datetime=tomorrow 3 PM             # easy__google-meet__004 (date-relative so it stays in the future)
invitee email 1=yuvraj.mist@gmail.com    # easy__google-meet__004 (attendee)
invitee email 2=rajceo2031@gmail.com     # easy__google-meet__004 (attendee, device owner's own Gmail)
size threshold=100MB  # medium__files__010
contact name=Maa
sender=Myntra
letter=Y
new email=yuvraj.new@example.com

# ---- location -----------------------------------------------------------
