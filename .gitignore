# --- generated / regenerable artifacts (do not commit; rebuild via scripts) ---
# Entire assets/ tree is local/HF (runs, seeds, Phoenix DBs, etc.) — never git.
# datasets/ stays at the repo root.
assets/
datasets/

# Exception: GitHub Pages paper figures under website/assets/img/ (force-ship with the site).
# Parent dirs must be re-included because `assets/` matches any path segment named assets.
!website/assets/
!website/assets/img/
!website/assets/img/**

# --- personal / device-specific data (never commit) ---
.env
config/user.yaml
backups/
.fabricated_test_data.json
benchmarks/androidlife-600/tasks_vars.local.env
benchmarks/androidlife-600/tasks_vars.local.json
benchmarks/androidlife-600/tasks_vars/
benchmarks/androidlife-600/public_vars.local.env
benchmarks/androidlife-600/tasks-private/
report_wireless.json
report_wireless.md

# --- tooling noise ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv
.venv.nosync/
.DS_Store
src/*.egg-info/
.deepeval/
.mobilerun/

# generated report artifacts (dailybench_report.py writes into CWD)
report.json
report.md
metrics/
coverage.xml
htmlcov/

# website build output
website/node_modules/

# dev scratch scripts (underscore-prefixed)
scripts/_*.py

# public-sample benchmark run artifacts (generated; not committed) — now live
# under assets/runs/public/ (covered by the assets/runs/ rule above)

# Hugging Face release staging (generated by scripts/data/export_hf_release.py)
hf_release/

# trajectory media + per-task data — published to HuggingFace (see
# scripts/tools/publish_trajectories.py), not committed to git. The small
# index.json manifest IS committed (it points at the HF resolve URLs).
website/assets/trajectories/
website/assets/data/trajectories/day*/
website/assets/data/trajectories/public/
