# DrainBench Public Sample — placeholder values (EXAMPLE / template)
#
# Every `[placeholder]` in public.md (57 tasks) must resolve before the run.
# Copy this to `public_vars.local.env` (gitignored — real values differ per
# device) and feed it to dailybench_tasks.py / the batch runner as repeated
# `--var key=value` flags, e.g.:
#   python -m DailyBench.task_batch --dataset DailyBench_public_v2.json \
#     --var "store=Decathlon" --var "contact=Yuvraj Airtel" ...
# Values below are realistic examples; the local file holds the exact values
# resolved against the actual test device (serial RS7XKZDI8HTOJNYL).

# ---- real device/identity values (see .fabricated_test_data.json) ----------
contact=Yuvraj Airtel            # safe selected contact for any task that messages [contact]
place=Bhubaneswar Airport        # real destination near the device's location
sender=Myntra                    # real most-recent Gmail sender
email-id=hafari4025@aghism.com   # safe send target (owner's own primary Gmail)
artist=The Weeknd                # real artist already in YouTube Music
middle initial=Kumar Sahoo       # write-instruction value for the contact task

# ---- per-task placeholders (alphabetical) -----------------------------------
bill amount=120                          # easy__calculator__007 (split evenly by 4)
contact updates title=Contact Updates    # hard__contacts-obsidian__029 (real Obsidian note)
exam scores note title=Exam Scores       # medium__calculator__001 (real Obsidian note)
food delivery site=Swiggy                # medium__shopping-delivery-browser__010 / easy__shopping-delivery-browser__001
meeting link=https://meet.google.com/abc-defg-hij   # medium__google-meet__003
note title=Daily Reflection              # medium__notes__005 (real Notes-app note)
passing threshold=60                     # medium__calculator__001
presentation name=Q3 Review              # easy/medium__google-slides__002 (seeded deck)
product 1=Sony WH-1000XM5                # hard__google-search-notes__019 (real, reviewable)
product 2=Bose QuietComfort Ultra        # hard__google-search-notes__019
recipe=World's Best Lasagna https://www.allrecipes.com/recipe/23600/worlds-best-lasagna/  # medium__clock__001
restaurant=Downtown Delight              # medium__shopping-delivery-browser__010 (real Swiggy restaurant)
shared bill note title=Shared Bill       # medium__calculator__005 (seeded Obsidian note)
sheet column=Views                       # medium__google-sheets__001 (SPORTS_VIDEO_DATA header)
shopping_website_1=amazon.in             # hard__chrome-telegram-notes__008
shopping_website_2=flipkart.com          # hard__chrome-telegram-notes__008
song=Blinding Lights                     # easy__music__009 (real in YouTube Music)
spreadsheet name=SPORTS_VIDEO_DATA       # medium__google-sheets__001/003 (real file)
store=Decathlon                          # easy__shopping-delivery-browser__012 (real store locator)
topic=best budget smartphones 2026       # medium__youtube__006
transit line=Route 205                   # hard__google-search-clock__056 (real bus route)
